<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or carried to a new phone: the settings include the camera's Wi-Fi password. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="sharedpref" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="sharedpref" />
  </device-transfer>
</data-extraction-rules>
