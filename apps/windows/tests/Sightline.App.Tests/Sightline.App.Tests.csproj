<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Sightline.App.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <!-- The first runner that knows xUnit v3; the v2 suites keep the older one. -->
    <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Sightline.App/Sightline.App.csproj" />
    <ProjectReference Include="../Sightline.Core.Testing/Sightline.Core.Testing.csproj" />
  </ItemGroup>

</Project>
