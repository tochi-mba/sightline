<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows: joining the camera's Wi-Fi goes through Windows' own Wi-Fi service. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Sightline.Cli</RootNamespace>
    <AssemblyName>sightline</AssemblyName>
    <Description>The sightline command: drive a Wi-Fi action camera from a terminal.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../protocol/dotnet/Sightline.Protocol/Sightline.Protocol.csproj" />
    <ProjectReference Include="../Sightline.Core/Sightline.Core.csproj" />
    <ProjectReference Include="../Sightline.Platform.Windows/Sightline.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sightline.Cli.Tests" />
  </ItemGroup>

</Project>
