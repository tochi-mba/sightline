<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource InkBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- The eyebrow: the signature of a REX screen. Tiny, bold, heavily tracked, upper case. -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.eyebrow.signal">
    <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- Tabular figures so a running clock does not jitter as its digits change. -->
  <Style Selector="TextBlock.readout">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Buttons: the primary one wears the signal colour, everything else is quiet. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource SignalBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#E4FF6E" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button.recording">
    <Setter Property="Background" Value="{StaticResource LiveBrush}" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.recording:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF8F6B" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- A status pill. -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
  </Style>

  <!-- The rail's page buttons: quiet until chosen, then the signal wash. -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Padding" Value="8,12" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
  </Style>

  <!-- Two or three choices side by side, the chosen one lit. -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Button.segment.selected">
    <Setter Property="Background" Value="{StaticResource SignalWashBrush}" />
    <Setter Property="Foreground" Value="{StaticResource SignalBrush}" />
  </Style>

  <!-- Words over the live picture, on a scrim so they read against any scene. -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="#B3080A09" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Border.badge.live">
    <Setter Property="BorderBrush" Value="{StaticResource LiveBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Framing guides: hairlines that stay out of the picture's way. -->
  <Style Selector="Rectangle.guide">
    <Setter Property="Fill" Value="#73F2F5EE" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

</Styles>
