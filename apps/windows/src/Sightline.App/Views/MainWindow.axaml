<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sightline.App.ViewModels"
        xmlns:up="using:Sightline.Core.Updates"
        xmlns:views="using:Sightline.App.Views"
        x:Class="Sightline.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Sightline"
        Icon="avares://Sightline/Assets/sightline.ico"
        Width="1200" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <Grid ColumnDefinitions="104,*">

      <!-- The rail: the four pages, always one tap away. -->
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,20">
          <TextBlock Classes="eyebrow signal" Text="REX" HorizontalAlignment="Center" />
          <StackPanel Grid.Row="1" Spacing="6" Margin="10,28,10,0">
            <Button Name="LiveTab" Classes="nav" Classes.selected="{Binding IsLive}" Content="Live"
                    Command="{Binding GoCommand}" CommandParameter="{x:Static vm:Page.Live}" />
            <Button Name="LibraryTab" Classes="nav" Classes.selected="{Binding IsLibrary}" Content="Card"
                    Command="{Binding GoCommand}" CommandParameter="{x:Static vm:Page.Library}" />
            <Button Name="SentryTab" Classes="nav" Classes.selected="{Binding IsSentry}" Content="Sentry"
                    Command="{Binding GoCommand}" CommandParameter="{x:Static vm:Page.Sentry}" />
            <Button Name="SettingsTab" Classes="nav" Classes.selected="{Binding IsSettings}" Content="Settings"
                    Command="{Binding GoCommand}" CommandParameter="{x:Static vm:Page.Settings}" />
          </StackPanel>
          <TextBlock Grid.Row="2" Classes="muted" Text="{Binding Version}" HorizontalAlignment="Center" />
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="28,20,28,18">

        <!-- The header: the product, the camera's connection in a word, and leaving it. -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,18">
          <StackPanel Spacing="2">
            <TextBlock Classes="eyebrow signal" Text="REX TECHNOLOGIES" />
            <TextBlock Text="Sightline" FontSize="24" FontWeight="Bold" />
          </StackPanel>
          <Border Grid.Column="1" Classes="pill" VerticalAlignment="Center"
                  IsVisible="{Binding ConnectionWord, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Name="ConnectionWord" Text="{Binding ConnectionWord}" FontSize="11" FontWeight="Bold" />
          </Border>
          <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Content="Disconnect"
                  Command="{Binding Connect.DisconnectCommand}" IsVisible="{Binding !ShowsConnect}" />
          <Button Grid.Column="3" Name="UpdateReady" Margin="12,0,0,0" VerticalAlignment="Center" Classes="primary"
                  Content="Update ready" Command="{Binding GoCommand}" CommandParameter="{x:Static vm:Page.Settings}"
                  IsVisible="{Binding Updates.Ready, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>

        <Panel Grid.Row="1">
          <views:LivePage IsVisible="{Binding IsLive}" />
          <Panel IsVisible="{Binding IsLibrary}">
            <views:LibraryPage DataContext="{Binding Library}" />
          </Panel>
          <Panel IsVisible="{Binding IsSentry}">
            <views:SentryPage DataContext="{Binding Sentry}" />
          </Panel>
          <Panel IsVisible="{Binding IsSettings}">
            <views:SettingsPage DataContext="{Binding Settings}" />
          </Panel>
        </Panel>

        <!-- What the camera last had to say, until dismissed. -->
        <Border Grid.Row="2" Name="NoticeBar" Margin="0,16,0,0" Classes="panel" Padding="14,10"
                IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissNoticeCommand}" Margin="12,0,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- The introduction, the first time. -->
    <Border Name="Onboarding" Background="{StaticResource InkBrush}" IsVisible="{Binding ShowOnboarding}">
      <StackPanel MaxWidth="560" VerticalAlignment="Center" Spacing="18" Margin="24">
        <TextBlock Classes="eyebrow signal" Text="REX TECHNOLOGIES" />
        <TextBlock Text="See through your camera. Stay online." FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="14"
                   Text="Sightline joins your action camera's Wi-Fi with an adapter this PC is not using for the internet, so you keep your connection while you watch, shoot and copy." />
        <StackPanel Spacing="10">
          <TextBlock TextWrapping="Wrap" Text="Local only: the camera's pictures stay between it and this PC." />
          <TextBlock TextWrapping="Wrap" Text="No account, no analytics, no ads." />
          <TextBlock TextWrapping="Wrap" Text="Before an adapter leaves a network, Sightline says so and asks." />
        </StackPanel>
        <Button Classes="primary" Content="Get started" HorizontalAlignment="Left"
                Command="{Binding FinishOnboardingCommand}" />
      </StackPanel>
    </Border>

    <!-- What changed, when an update earned a word. -->
    <Border Name="WhatsNew" Background="#CC080A09" IsVisible="{Binding ShowsWhatsNew}">
      <Border Classes="panel" MaxWidth="520" VerticalAlignment="Center" Margin="24">
        <StackPanel Spacing="14">
          <TextBlock Classes="eyebrow signal" Text="WHAT'S NEW" />
          <ItemsControl ItemsSource="{Binding WhatsNew}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="up:WhatsNewEntry">
                <StackPanel Spacing="6" Margin="0,0,0,12">
                  <TextBlock Classes="title" Text="{Binding Version}" />
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock TextWrapping="Wrap" Text="{Binding}" Margin="0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="primary" Content="Got it" HorizontalAlignment="Left" Command="{Binding CloseWhatsNewCommand}" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
