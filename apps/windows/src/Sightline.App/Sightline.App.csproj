<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-only: joining Wi-Fi goes through netsh, and the app ships as a Windows installer. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Sightline.App</RootNamespace>
    <!-- Not "Sightline": the command line is sightline.exe, and Windows names ignore case, so the two would
         overwrite each other in the one install folder. The Start menu shows the package title, Sightline. -->
    <AssemblyName>Sightline.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by tools/scripts/generate_icon.py from the site's favicon; regenerate rather than edit. -->
    <ApplicationIcon>Assets\sightline.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Sightline for Windows: live view and control for Wi-Fi action cameras.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Already shipped by Avalonia; used directly to read a frame's brightness for Sentry. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../protocol/dotnet/Sightline.Protocol/Sightline.Protocol.csproj" />
    <ProjectReference Include="../Sightline.Core/Sightline.Core.csproj" />
    <ProjectReference Include="../Sightline.Platform.Windows/Sightline.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sightline.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
