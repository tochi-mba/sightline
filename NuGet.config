<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Sightline is standalone. Inherited feeds are cleared so a build never depends on a private
       source unrelated to this project. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
