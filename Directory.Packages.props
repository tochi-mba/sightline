<Project>

  <!--
    Every NuGet version in the solution, in one place. A project names the packages it uses and
    never their versions, so two projects cannot drift onto different releases of the same package.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="The Windows app">
    <!-- The same Avalonia and MVVM releases REX Technologies' Flint ships with, so the two desktop
         apps share one UI stack and one set of upgrade decisions. -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Installs and updates the Windows app; the vpk tool in .config/dotnet-tools.json is the same version. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <!-- The newest stable BenchmarkDotNet; 0.16 is still a preview. A benchmark library is the
         measuring instrument, and a new one can move every figure without the code changing, so
         it is upgraded on purpose and the baseline is re-recorded in the same change. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- The SkiaSharp Avalonia 12.1.3 draws with, so the decode benchmark times the decoder the
         Windows app ships. Transitive pinning makes this the app's version as well, which is why it
         must move with Avalonia: an Avalonia that needs a newer one fails restore until it does. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The app's suite runs on xUnit v3, which Avalonia's headless testing needs; the others stay on v2.
         These are the versions REX Technologies' Flint app already tests its Avalonia 12 window with. -->
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="3.2.2" />
  </ItemGroup>

</Project>
